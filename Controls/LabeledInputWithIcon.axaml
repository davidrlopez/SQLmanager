<UserControl
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:fa="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
  x:Class="SQLmanager.Controls.LabeledInputWithIcon"
  x:DataType="local:LabeledInputWithIcon"
  xmlns:local="clr-namespace:SQLmanager.Controls">
  <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto">
    <ContentControl x:Name="IconPresenter"
                    Margin="0,0,8,0"
                    VerticalAlignment="Center"/>
    <StackPanel Grid.Column="1">
      <TextBlock Text="{Binding LabelText}" FontWeight="Bold" Margin="0,0,0,4"/>
<TextBox Text="{Binding Text, Mode=TwoWay}" />
    </StackPanel>
  </Grid>
</UserControl>